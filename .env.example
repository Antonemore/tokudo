# ==========================================
# TOKUDO AI SYSTEM CONFIGURATION
# ==========================================

# Multi-PC Node Identifier (Prefixed on all responses, e.g. [DESKTOP-MAIN])
MACHINE_ID=PC-WINDOWS-01

# ==========================================
# SECURITY & ACCESS CONTROL (WHITELIST)
# ==========================================
# Only these specific IDs will be processed. All other requests are silently dropped.
# Comma-separated if multiple admin IDs are needed.
TELEGRAM_ALLOWED_USER_ID=123456789
DISCORD_ALLOWED_USER_ID=123456789012345678

# Human-In-The-Loop Approval (true = sensitive terminal/OS actions require approval button)
SECURITY_REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_SECONDS=300

# ==========================================
# FRONTEND BOT TOKENS
# ==========================================
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Optional: Discord fallback channel ID for broadcast/background task notifications
DISCORD_DEFAULT_CHANNEL_ID=123456789012345678

# ==========================================
# LLM ENGINE CONFIGURATION
# ==========================================
# LLM Provider: 'openai' (works with OpenAI, DeepSeek, Local Ollama, Groq) or 'gemini'
LLM_PROVIDER=openai

# OpenAI / OpenAI-Compatible (DeepSeek / Ollama / Local AI)
OPENAI_API_KEY=your_openai_or_deepseek_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Google Gemini (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ==========================================
# VISUAL WEB DASHBOARD (UI)
# ==========================================
# Access full GUI for Multi-Brain Account Management, Telemetry, and System Stats
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# ==========================================
# BRAIN & STORAGE PATHS
# ==========================================
DATA_DIR=data
BRAIN_DIR=brain
WIKI_DIR=brain/wiki
MEMORY_DIR=brain/memory
INDEX_DB_PATH=brain/index.db
KANBAN_DB_PATH=data/kanban.db
